    "@remotion/renderer": "4.0.528",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.528"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
